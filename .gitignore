# Allowlist mode: ignore everything by default, !unignore only what to track.

*

# Top-level
!.gitignore
!.dockerignore
!.env.example
!LICENSE
!README.md
!compose.yaml

# scripts/
!scripts/
!scripts/*.sh

# app/
!app/
!app/Dockerfile
!app/*.py
!app/requirements.txt

# app/frontend/
!app/frontend/
!app/frontend/index.html
!app/frontend/package.json
!app/frontend/package-lock.json
!app/frontend/vite.config.js

# app/frontend/src/
!app/frontend/src/
!app/frontend/src/*.js
!app/frontend/src/*.jsx
!app/frontend/src/*.css
!app/frontend/src/*.json
!app/frontend/src/components/
!app/frontend/src/components/*.jsx